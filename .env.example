# Servicos internos (obrigatorias)
UPSTREAM_AUTH_URL=http://localhost:3002
UPSTREAM_CATALOG_URL=http://localhost:3000
UPSTREAM_TRANSPORT_URL=http://localhost:3001
UPSTREAM_CUSTOMER_URL=http://localhost:3003
UPSTREAM_SALES_ORDER_URL=http://localhost:3004

# Validacao de JWT (obrigatoria): JWKS do ms-auth
AUTH_JWKS_URL=http://localhost:3002/.well-known/jwks.json

# Opcionais (valores padrao)
NODE_ENV=development
PORT=8088
# Porta interna do /metrics (Prometheus); nao publicar
METRICS_PORT=9464
LOG_LEVEL=info
AUTH_ISSUER=ms-auth
AUTH_AUDIENCE=ms-platform
JWKS_CACHE_MAX_AGE_MS=600000
UPSTREAM_TIMEOUT_MS=10000
MAX_BODY_BYTES=1048576
THROTTLE_DEFAULT_TTL_MS=60000
THROTTLE_DEFAULT_LIMIT=300
HEALTH_CHECK_TIMEOUT_MS=1500
SHUTDOWN_TIMEOUT_MS=10000
