{
  "name": "ms-gateway",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:integration": "jest --config test/jest-integration.json --runInBand",
    "lint": "eslint --max-warnings=0 ."
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/terminus": "^11",
    "@nestjs/throttler": "^6",
    "helmet": "^8",
    "http-proxy-middleware": "^3",
    "jose": "^5",
    "nestjs-pino": "^4.6.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tsconfig-paths": "^4.2.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@nestjs/cli": "^11.0.24",
    "@types/express": "^4.17.21",
    "@types/jest": "^29",
    "@types/node": "^20.19.43",
    "eslint": "^9",
    "jest": "^29",
    "pino-pretty": "^13.1.3",
    "ts-jest": "^29",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8"
  },
  "jest": {
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node",
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "moduleNameMapper": {
      "^@domain/(.*)$": "<rootDir>/domain/$1",
      "^@application/(.*)$": "<rootDir>/application/$1",
      "^@infrastructure/(.*)$": "<rootDir>/infrastructure/$1",
      "^@common/(.*)$": "<rootDir>/common/$1",
      "^@config/(.*)$": "<rootDir>/config/$1"
    }
  },
  "packageManager": "yarn@1.22.22"
}
